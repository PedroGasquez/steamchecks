# Copie para .env (nunca commite o .env). Na VM: ~/steamtracker/.env
POSTGRES_PASSWORD=

# Opcionais: sem valor aqui, vale o appsettings.json. Exemplos (valores atuais):
# SteamMarket__Currency=7   # só 7 (BRL) é suportado por ora: o parser de preço assume vírgula decimal (USD seria gravado errado)
# PriceCollection__Interval=00:15:00
# PriceCollection__DelayBetweenItems=00:00:03
